{
  "name": "@innovatsiina-diia/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}
